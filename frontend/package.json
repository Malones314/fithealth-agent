{
  "name": "fithealthagent-frontend",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "check:boundaries": "node ../scripts/check_frontend_boundaries.mjs",
    "check:governance": "node ../scripts/check_frontend_governance.mjs",
    "check:architecture": "node ../scripts/check_frontend_architecture.mjs",
    "test:architecture-rules": "node --test ../scripts/frontend_architecture_rules.test.mjs",
    "check:components": "node ../scripts/check_frontend_components.mjs",
    "check:styles": "node ../scripts/check_frontend_styles.mjs",
    "check:bundle": "node ../scripts/check_frontend_bundle.mjs",
    "report:bundle": "node ../scripts/check_frontend_bundle.mjs --report",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test e2e/",
    "test:e2e:smoke": "playwright test e2e/frontend-smoke.spec.ts --project=desktop-1440",
    "test:e2e:layout": "playwright test e2e/frontend-layout.spec.ts",
    "test:e2e:races": "playwright test e2e/frontend-races.spec.ts --project=desktop-1440",
    "test:e2e:session": "playwright test e2e/frontend-session.spec.ts --project=desktop-1440",
    "test:e2e:baseline": "playwright test e2e/frontend-baseline.spec.ts",
    "test:e2e:baseline:update": "playwright test e2e/frontend-baseline.spec.ts --update-snapshots"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "dompurify": "3.4.15",
    "marked": "16.4.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.63.0",
    "@types/dompurify": "3.0.5",
    "@types/node": "24.3.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
